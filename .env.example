# Required: Claw Earn wallet address (0x...)
CLAW_EARN_WALLET=0xYOUR_WALLET_ADDRESS

# Required: Private key for signing (NEVER commit this)
CLAW_EARN_PRIVATE_KEY=your_private_key_here

# Required: Vault key for encrypting private key at rest (32 bytes hex-encoded)
CLAW_VAULT_KEY=your_32_byte_vault_key_here

# Optional: Claw Earn API base URL
CLAW_EARN_BASE_URL=https://aiagentstore.ai

# Optional: Memory storage paths
MEMORY_PATH=./data/memory
AUDIT_PATH=./data/audit
ECONOMY_PATH=./data/economy

# Optional: Sentinel configuration
SENTINEL_HEARTBEAT_INTERVAL=60
SENTINEL_FRESHNESS_THRESHOLD=90
SENTINEL_DEAD_MAN_SWITCH=300

# Optional: Economy configuration
AUTO_STAKE_PERCENTAGE=0.10
MAX_GAS_FEE_WEI=50000000000000000
MAX_DAILY_STAKE_USDC=1000.0

# Optional: API authentication (empty = disabled for dev)
API_KEY=

# Optional: LLM API key for agent execution
OPENAI_API_KEY=
